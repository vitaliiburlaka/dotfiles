# get current location
DOTFILES_DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )

BACKUP_DIR=dotfiles-backup

echo "running from $DOTFILES_DIR..."

# **********************************
# GIT
#

# backup ~/.gitconfig
if [ -f ~/.gitconfig ]; then
  echo "found old ~/.gitconfig - backing up to $BACKUP_DIR..."
  mkdir $BACKUP_DIR
  mv ~/.gitconfig $BACKUP_DIR/.gitconfig
fi

# link ~/.gitconfig
echo "sym linking new ~/.gitconfig with $DOTFILES_DIR/.gitconfig!\n"
ln -s $DOTFILES_DIR/.gitconfig ~/.gitconfig

# *********************************
# zsh
#
if [ -L ~/.zshrc ]; then
  echo "found .zshrc - backing up to $BACKUP_DIR..."
  mv ~/.zshrc $BACKUP_DIR/.zshrc
fi

echo $'linking .zshrc\n'
ln -s $DOTFILES_DIR/.zshrc ~/.zshrc



if [ -f ~/.aliases ]; then
  echo "found old .aliases - backing up to $BACKUP_DIR..."
  mv ~/.aliases $BACKUP_DIR/.aliases
fi

echo $'linking .aliases\n'
ln -s $DOTFILES_DIR/.aliases ~/.aliases




# *************************************
# npm
#
if [ -L ~/.npmrc ]; then
  echo "found old .npmrc - removing..."
  rm ~/.npmrc
fi

echo $'linking .npmrc\n'
ln -s $DOTFILES_DIR/.npmrc ~/.npmrc


# Formulae, casks and taps (replaces the old brew.sh / cask.sh)
if command -v brew > /dev/null 2>&1; then
  brew bundle --file="$DOTFILES_DIR/Brewfile"
else
  echo "Homebrew not found. Install it from https://brew.sh, then re-run."
fi

# node, via nvm's official installer (replaces the old node.sh, which
# pointed at creationix/nvm — that repo moved to nvm-sh years ago)
if [ ! -d "$HOME/.nvm" ]; then
  curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.2/install.sh | bash
  export NVM_DIR="$HOME/.nvm"
  # shellcheck disable=SC1091
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  nvm install --lts
  nvm alias default node
fi

# Visual Studio Code settings (previously done inside cask.sh)
VSCODE_USER_DIR="$HOME/Library/Application Support/Code/User"
if [ -d "$VSCODE_USER_DIR" ]; then
  ln -sfn "$DOTFILES_DIR/vscode-settings.json" "$VSCODE_USER_DIR/settings.json"
fi

bash $DOTFILES_DIR/code.sh