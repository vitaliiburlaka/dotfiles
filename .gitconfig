[user]
	name = Vitalii Burlaka
	email = vitalii.burlaka@gmail.com
[alias]
	co = checkout
	br = branch
	cm = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	poh = push origin HEAD
[credential "https://github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
