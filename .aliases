#!/usr/bin/env bash

_dt_alias_os="$(uname -s)"

# Navigation Shortcuts: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias home="cd ~"       # `cd` is probably faster to type though
alias -- -="cd -"       # jump to previous destination

# File system Shortcuts
if [ "$_dt_alias_os" = Darwin ]; then
  alias o='open .'
else
  alias o='xdg-open .'
fi
alias p="cd ~/Projects"
alias apps='cd ~/Applications'
alias docs='cd ~/Documents'
alias dls='cd ~/Downloads'
alias pics='cd ~/Pictures'
alias music='cd ~/Music'
alias movies='cd ~/Movies'
alias desktop='cd ~/Desktop'

# Directory listing with colors
alias sl=ls
if [ "$_dt_alias_os" = Darwin ]; then
  alias ls='ls -G'
else
  alias ls='ls --color=auto'
fi
alias la='ls -A'        # Compact view, show hidden
alias ll='ls -alF'
alias l='ls -CF'
alias l1='ls -1'

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Get week number
alias week='date +%V'
# weather and the moon
alias weather='curl -4 https://wttr.in/Niagara+Falls+Ontario'
alias moon='curl -4 https://wttr.in/Moon'

# Desktop Apps
# `open -a <name>` resolves via LaunchServices, so it keeps working when an
# app moves and does not depend on the bundle's exact capitalisation.
[ "$_dt_alias_os" != Darwin ] || alias xcode='open -a Xcode'
[ "$_dt_alias_os" != Darwin ] || alias safari='open -a Safari'
if [ "$_dt_alias_os" = Darwin ]; then
  alias chrome='open -a "Google Chrome"'
  alias discord='open -a Discord'
else
  alias chrome='google-chrome'
  alias discord='discord'
fi
[ "$_dt_alias_os" != Darwin ] || alias f='open -a Finder '
[ "$_dt_alias_os" != Darwin ] || alias textedit='open -a TextEdit'

# Utils
# -delete rather than `| xargs -0 rm`, which runs rm with no arguments (and
# so errors) when there is nothing to delete.
alias dsclean='find . -type f -name .DS_Store -delete'
alias encode-file='iconv -f ISO-8859-1 -t UTF-8'
alias usage='df -h'
alias space='du -sh ./*'
if [ "$_dt_alias_os" = Darwin ]; then
  alias tu='top -o cpu'
else
  alias tu='top -o %CPU'
fi
alias trim="tr -s \" \" | sed 's/^[ ]//g'"
alias total-files='ls -1 | wc -l | trim'
# Stop Spotlight indexing node_modules
[ "$_dt_alias_os" != Darwin ] || alias node-spotlight-ignore="find . -type d -path '*node_modules/*' -prune -o -type d -name 'node_modules' -exec touch '{}/.metadata_never_index' \;"

# Editing and reloading shell config
alias sb="source ~/.bashrc"
alias eb='${EDITOR:-vim} ~/.bashrc'
alias sz="source ~/.zshrc"
alias ez='${EDITOR:-vim} ~/.zshrc'

# Homebrew stuff
# `brew upgrade` covers casks too, so the old trailing `brew upgrade --cask`
# was a no-op second pass.
alias bup='brew update && brew upgrade && brew cleanup'
alias bout='brew outdated'
alias bdump='brew bundle dump --file=~/.dotfiles/Brewfile --force --describe'

# Git stuff
# Note: gst/gco/gb come from the oh-my-zsh git plugin — do not redefine them
# here. This file is sourced after oh-my-zsh, so anything defined here wins
# silently, which is how `gbr` used to shadow omz's `git branch --remote`.
alias gti="git"
_dt_copy_public_key() {
  local key
  for key in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub"; do
    [ -f "$key" ] || continue
    if command -v pbcopy >/dev/null 2>&1; then
      pbcopy < "$key" || return
    elif command -v wl-copy >/dev/null 2>&1; then
      wl-copy < "$key" || return
    elif command -v xclip >/dev/null 2>&1; then
      xclip -selection clipboard < "$key" || return
    else
      printf '%s\n' 'public-key: install wl-copy or xclip for clipboard support' >&2
      return 1
    fi
    printf 'copied %s to clipboard\n' "$key"
    return 0
  done
  printf '%s\n' 'public-key: no supported public key found' >&2
  return 1
}
alias public-key='_dt_copy_public_key'

# Docker and K8s
alias dps="docker ps"
alias k="kubectl"

# Network stuff
# IP addresses
# Public IP. The long-standing `dig +short myip.opendns.com @resolver1.opendns.com`
# trick returns an empty answer now — the resolver still resolves, it just no
# longer answers that query — so this uses HTTPS with a second source as backup.
alias public-ip="curl -4 -s --max-time 5 https://icanhazip.com || curl -4 -s --max-time 5 https://ifconfig.me"
[ "$_dt_alias_os" != Darwin ] || alias ip=public-ip
if [ "$_dt_alias_os" = Darwin ]; then
  alias lip='ipconfig getifaddr en0'
else
  alias lip="command ip -4 route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if(\$i==\"src\") print \$(i+1)}'"
fi
if [ "$_dt_alias_os" = Darwin ]; then
  alias ips="ifconfig -a | awk '/inet6? / {print \$2}'"
else
  alias ips="command ip -o addr show | awk '{print \$4}'"
fi

# Show active network interfaces
# Uses awk rather than pcregrep: pcregrep is only installed here as a
# transitive dependency and would disappear on the next `brew autoremove`.
[ "$_dt_alias_os" != Darwin ] || alias ifactive="ifconfig | awk '/^[a-z0-9]+:/{iface=substr(\$1, 1, length(\$1)-1)} /status: active/{print iface}'"

# Flush your DNS cache
# dscacheutil alone stopped being sufficient years ago; mDNSResponder holds
# its own cache and must be signalled too.
[ "$_dt_alias_os" != Darwin ] || alias flushdns="sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo 'DNS cache flushed'"

# Usefull stuff for presentation and seeing dotfiles
[ "$_dt_alias_os" != Darwin ] || alias hidedesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
[ "$_dt_alias_os" != Darwin ] || alias showdesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"
[ "$_dt_alias_os" != Darwin ] || alias showall='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
[ "$_dt_alias_os" != Darwin ] || alias hideall='defaults write com.apple.finder AppleShowAllFiles NO && killall Finder'

# macOS has no `md5sum`, so use `md5` as a fallback
command -v md5sum >/dev/null 2>&1 || { command -v md5 >/dev/null 2>&1 && alias md5sum="md5"; }

# macOS has no `sha1sum`, so use `shasum` as a fallback
command -v sha1sum >/dev/null 2>&1 || { command -v shasum >/dev/null 2>&1 && alias sha1sum="shasum"; }

# URL-encode strings
alias urlencode='python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))"'

# Merging PDFs is now `pdf-merge` in ~/.functions. The old alias pointed at
# /System/Library/Automator/Combine PDF Pages.action, which Apple removed.
#
# The `airport` alias is gone entirely: that binary was deprecated and then
# removed from Apple80211.framework, and there is no drop-in replacement.
# Closest equivalents:
#   system_profiler SPAirPortDataType     current Wi-Fi details
#   wdutil info                           requires sudo, more detail

# Sleep the display (when going AFK). The old CGSession path was removed
# from User.menu.
[ "$_dt_alias_os" != Darwin ] || alias afk='pmset displaysleepnow'

# Print each PATH entry on a separate line.
# Piped through tr rather than using ${PATH//:/\\n}: zsh does not word-split
# unquoted expansions, so the substitution approach prints one long line there.
alias path='printf "%s" "$PATH" | tr ":" "\n"'

# local logs
# /var/log/system.log is near-empty since macOS moved to unified logging.
[ "$_dt_alias_os" != Darwin ] || alias syslog='log show --last 30m --style compact'
unset _dt_alias_os
:
