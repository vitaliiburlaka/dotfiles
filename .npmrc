//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# npm only honours the dashed key names. The dotted forms used here
# previously (init.author.email, init.license, init.version) were stored
# verbatim but never applied — `npm config get init-license` returned npm's
# built-in ISC default rather than MIT, and init-version returned 1.0.0
# rather than 0.1.0. The `email` key was an npm v1 leftover and did nothing.
init-author-name=Vitalii Burlaka
init-author-email=vitalii.burlaka@gmail.com
init-license=MIT
init-version=0.1.0
